# Public Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin service account (server only; never expose as NEXT_PUBLIC_*)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_APP_HOSTING_PROJECT_ID=
FIREBASE_APP_HOSTING_LOCATION=
FIREBASE_APP_HOSTING_BACKEND_ID=
TIME_MACHINE_SCHEDULER_AUDIENCE=
TIME_MACHINE_SCHEDULER_SERVICE_ACCOUNT_EMAIL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe Billing (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEEKLY_PRICE_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local debug UI only. Debug builds unlock every course lesson for testing.
NEXT_PUBLIC_COURSIV_DEBUG_ADMIN=false
COURSIV_DEBUG_ADMIN_LIVE=false

# Meta advertising measurement (token is server-only)
NEXT_PUBLIC_META_PIXEL_ID=
META_DATASET_ID=
META_CONVERSIONS_API_TOKEN=
META_GRAPH_API_VERSION=
# Staging/Test Events only. Keep empty in production.
META_TEST_EVENT_CODE=

# Certificate completion email (server only)
RESEND_API_KEY=
CERTIFICATE_FROM_EMAIL=Lumora <certificates@yourdomain.com>
SUPPORT_FROM_EMAIL=Lumora Support <support@yourdomain.com>
SUPPORT_TO_EMAIL=

# New-account welcome email (server only)
WELCOME_FROM_EMAIL=contact@zoomob.com
WELCOME_REPLY_TO_EMAIL=contact@zoomob.com

# OpenAI-compatible chat provider (server only)
AI_API_URL=
AI_API_KEY=
AI_MODEL=
