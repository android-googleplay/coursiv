{
  "name": "ai-income-challenge",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "debug:build": "NEXT_PUBLIC_COURSIV_DEBUG_ADMIN=true next build",
    "debug:start": "NEXT_PUBLIC_COURSIV_DEBUG_ADMIN=true COURSIV_DEBUG_ADMIN_LIVE=true next start --port 3014",
    "lint": "eslint .",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:live": "node --env-file=.env.local scripts/live-firebase-e2e.mjs",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:qa:pr": "npm test && npm run qa:corpus && npm run qa:reference && npm run test:e2e -- --grep @golden",
    "test:qa:release": "npm run lint && npx tsc --noEmit && npm run build && npm test && npm run qa:corpus && npm run qa:reference && npm run test:e2e",
    "qa:corpus": "node scripts/qa-full-corpus.mjs",
    "qa:reference": "node scripts/qa-reference.mjs",
    "qa:visual-diff": "node scripts/qa-visual-diff.mjs",
    "content:sync": "node --env-file=.env.local --experimental-strip-types scripts/sync-content.mjs",
    "cms:import": "node --env-file=.env.local scripts/import-canonical-cms.mjs",
    "cms:migrate-courses": "node --env-file=.env.local scripts/migrate-course-metadata.mjs",
    "cms:rebuild-users": "node --env-file=.env.local scripts/rebuild-admin-user-summaries.mjs",
    "cms:rebuild-tickets": "node --env-file=.env.local scripts/rebuild-ticket-search.mjs",
    "cms:verify-firestore": "node --env-file=.env.local scripts/verify-firestore-content.mjs",
    "cms:launch-ai-workday": "node --env-file=.env.local scripts/launch-ai-workday.mjs",
    "cms:launch-ai-workday:apply": "node --env-file=.env.local scripts/launch-ai-workday.mjs --apply",
    "content:basic-law:build": "node scripts/build-basic-law-course.mjs",
    "content:sync-ai-workday-local": "node scripts/sync-ai-workday-local.mjs",
    "time-machine": "node --env-file=.env.local scripts/time-machine.mjs",
    "test:admin:live": "node --env-file=.env.local scripts/qa-admin-rbac-live.mjs",
    "coursiv:auth": "node --experimental-strip-types scripts/scrape-coursiv.mjs auth",
    "coursiv:discover": "node --experimental-strip-types scripts/scrape-coursiv.mjs discover",
    "coursiv:scrape": "node --experimental-strip-types scripts/scrape-coursiv.mjs scrape",
    "coursiv:resume": "node --experimental-strip-types scripts/scrape-coursiv.mjs resume",
    "coursiv:complete": "node --experimental-strip-types scripts/scrape-coursiv.mjs complete",
    "coursiv:verify": "node --experimental-strip-types scripts/scrape-coursiv.mjs verify",
    "coursiv:onboarding:scrape": "node scripts/scrape-coursiv-onboarding.mjs scrape",
    "coursiv:onboarding:verify": "node scripts/scrape-coursiv-onboarding.mjs verify"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-tc": "^0.4.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "lucide-react": "latest",
    "next": "^16.2.11",
    "pdf-lib": "^1.17.1",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.17.2",
    "sanitize-html": "^2.17.6",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pngjs": "^6.0.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
