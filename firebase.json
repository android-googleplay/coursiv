{
  "apphosting": [
    {
      "backendId": "coursiv",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".playwright-cli",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "output",
        "playwright-report",
        "test-results",
        "tmp"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
