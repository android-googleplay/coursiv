{
  "apphosting": [
    {
      "backendId": "coursiv",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".playwright-cli",
        "public/coursiv-media",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "output",
        "playwright-report",
        "test-results",
        "tmp"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/coursiv-media/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
